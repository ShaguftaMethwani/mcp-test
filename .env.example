# ─────────────────────────────────────────────
# Play Store Weekly Pulse — Environment Config
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────

# Groq API key
GROQ_API_KEY=

# Groq model to use
GROQ_MODEL=llama-3.1-70b-versatile

# Email address that will receive the weekly pulse draft
RECIPIENT_EMAIL=test@example.com

# ID of the Google Doc to append the weekly pulse to
GOOGLE_DOC_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ─── Groww Play Store Config ────────────────────
# Google Play Store package ID for Groww
APP_ID=com.nextbillion.groww

# Number of weeks of reviews to fetch (default: 8)
WEEKS_LOOKBACK=8

# Max reviews to fetch per scraper call (increase for longer windows)
MAX_REVIEWS_PER_FETCH=2000

# Country and language for Play Store reviews
REVIEW_COUNTRY=in
REVIEW_LANG=en

# ─── MCP Server Config ───────────────────────
# Remote MCP server URL for Google integrations
REMOTE_MCP_URL=https://mcpserver-test-production.up.railway.app/mcp
