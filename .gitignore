# ─────────────────────────────────────────
# Git ignore rules for Play Store Pulse
# ─────────────────────────────────────────

# Environment variables — never commit
.env

# Exported review data — may contain PII
data/*.csv
data/*.xlsx
data/*.json
!data/.gitkeep           # Keep the data/ directory in git

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
